# Application
APP_NAME=TraceGraph AI
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
STREAM_SHUTDOWN_TIMEOUT_SECONDS=5

# Browser origin and CORS
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# Public portfolio demo access. Local development defaults to enabled.
PUBLIC_UPLOADS_ENABLED=false

# Gemini
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-2
GENERATION_MODEL=gemini-3.6-flash
CONTEXTUALIZATION_MODEL=gemini-3.5-flash-lite
GRAPH_EXTRACTION_MODEL=gemini-3.5-flash-lite
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2

# Neo4j
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# Qdrant
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_HYBRID_COLLECTION=tracegraph_chunks_hybrid
